# ==========================================
# MULTI-AI CHESS ENGINE CONFIGURATION
# สำหรับรัน Local และ Deploy ขึ้น Vercel
# ==========================================

# 1. Google Gemini (ค่าเริ่มต้น แนะนำ ฟรีโควตา)
# รับคีย์ฟรีได้ที่: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-flash-lite"

# 2. OpenAI (ChatGPT - ทางเลือกสำหรับเล่นกับ GPT-4o-mini / GPT-4o)
# รับคีย์ได้ที่: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"

# 3. DeepSeek (ทางเลือกสำหรับเล่นกับ DeepSeek-Chat / DeepSeek-Reasoner)
# รับคีย์ได้ที่: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_MODEL="deepseek-chat"
