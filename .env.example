# ==========================================
# GEMINI API CONFIGURATION FOR LOCAL & VERCEL
# ==========================================

# GEMINI_API_KEY: คีย์ API สำหรับประมวลผลตาเดินหมากรุกของ AI (จำเป็นต้องใส่)
# รับคีย์ได้ฟรีที่: https://aistudio.google.com/app/apikey
# สำหรับ Vercel: ให้เพิ่มตัวแปรชื่อนี้ใน Vercel Dashboard -> Settings -> Environment Variables
GEMINI_API_KEY="your_gemini_api_key_here"

# GEMINI_MODEL: โมเดล AI ที่ต้องการใช้ (ทางเลือก ค่าเริ่มต้นคือ gemini-3.1-flash-lite)
# ตัวอย่าง: gemini-3.1-flash-lite, gemini-3.8-flash
GEMINI_MODEL="gemini-3.1-flash-lite"
